{
  "name": "eu4-special-escape",
  "displayName": "EU4 Special Escape",
  "description": "EU4特殊字符转义工具 - 一键处理本地化文件中的特殊字符",
  "version": "0.0.2",
  "publisher": "gjcloak",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "keywords": [
    "eu4",
    "localisation",
    "escape",
    "unicode",
    "paradox"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gjcloak/eu4-special-escape"
  },
  "license": "MIT",
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:eu4-special-escape.escape",
    "onCommand:eu4-special-escape.toggleSettings"
  ],
  "contributes": {
    "commands": [
      {
        "command": "eu4-special-escape.escape",
        "title": "EU4: 转义选中文本",
        "category": "EU4"
      },
      {
        "command": "eu4-special-escape.toggleSettings",
        "title": "EU4: 切换设置",
        "category": "EU4"
      }
    ],
    "keybindings": [
      {
        "command": "eu4-special-escape.escape",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "eu4-special-escape.escape",
          "group": "EU4@1",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "title": "EU4 Special Escape",
      "properties": {
        "eu4SpecialEscape.utf8": {
          "type": "boolean",
          "default": true,
          "description": "使用UTF-8编码（EU4专用）"
        },
        "eu4SpecialEscape.newVersion": {
          "type": "boolean",
          "default": true,
          "description": "使用EU4 1.26+新规则"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "16.x",
    "typescript": "^5.1.6"
  }
}